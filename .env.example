# ==============================================================================
# ISURU SERVICE CENTER POS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Port
PORT=5050

# Local Docker Ports
FRONTEND_PORT=8081
BACKEND_PORT=5050
POSTGRES_PORT=5432

# Production VPS Port (Port 8443 reserved as public HTTPS entry point)
PRODUCTION_HTTPS_PORT=8443

# PostgreSQL Database Credentials
POSTGRES_USER=isuru_pos_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production_2026
POSTGRES_DB=isuru_pos
POSTGRES_HOST=postgres

# Prisma Database Connection URL
# For Docker Compose: postgresql://isuru_pos_user:password@postgres:5432/isuru_pos?schema=public
# For Local Development: postgresql://isuru_pos_user:password@127.0.0.1:5432/isuru_pos?schema=public
DATABASE_URL=postgresql://isuru_pos_user:replace_with_strong_password_in_production_2026@postgres:5432/isuru_pos?schema=public

# Security Secrets (Must be changed in production!)
JWT_SECRET=replace_with_cryptographically_secure_random_64_byte_string

# Frontend Client Origin
CLIENT_URL=http://localhost:8081

# Migration Only: Source MongoDB URI (Not required at runtime)
MONGODB_URI=mongodb://127.0.0.1:27017/isuru_billing

# Backup Configuration
BACKUP_DIR=/var/backups/postgres
BACKUP_RETENTION_DAYS=14
