{
  "name": "isuru-service-center-mern",
  "version": "1.0.0",
  "description": "ISURU Service Center Billing System - Production Ready MERN Stack Application",
  "main": "backend/dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm run test",
    "migrate": "cd migration && npm run migrate"
  },
  "keywords": [
    "service-center",
    "billing",
    "mern",
    "mongodb",
    "express",
    "react",
    "nodejs",
    "pos"
  ],
  "author": "ISURU Service Center",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
