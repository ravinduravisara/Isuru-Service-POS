# ==============================================================================
# ISURU SERVICE CENTER POS - BACKEND ENVIRONMENT TEMPLATE
# ==============================================================================

PORT=5050
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://isuru_pos_user:replace_with_strong_password@127.0.0.1:5432/isuru_pos?schema=public

# Cryptographically strong secret (Min 32 characters required in production)
JWT_SECRET=replace_with_cryptographically_secure_random_64_byte_string_in_prod
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,https://88.222.242.20:8443

# Initial First-Run Administrator Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password_2026!

# One-time MongoDB Migration (not needed during standard runtime)
MONGODB_URI=mongodb://127.0.0.1:27017/isuru_billing
