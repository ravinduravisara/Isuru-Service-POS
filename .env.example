# ==============================================================================
# ISURU SERVICE CENTER POS - PRODUCTION & DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Backend Server Internal Port
PORT=5050

# Local Docker Ports (development stack)
FRONTEND_PORT=8081
BACKEND_PORT=5050
POSTGRES_PORT=5432

# Production VPS Port (Port 8443 reserved as public HTTPS entry point)
PRODUCTION_HTTPS_PORT=8443

# PostgreSQL Database Credentials (private internal network only)
POSTGRES_USER=isuru_pos_user
POSTGRES_PASSWORD=replace_with_strong_random_db_password_2026
POSTGRES_DB=isuru_pos
POSTGRES_HOST=postgres

# Prisma Database Connection URL
DATABASE_URL=postgresql://isuru_pos_user:replace_with_strong_random_db_password_2026@postgres:5432/isuru_pos?schema=public

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace_with_cryptographically_secure_random_64_byte_string_for_production
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated, include public IP / domain with port)
CORS_ORIGIN=https://88.222.242.20:8443,http://localhost:5173,http://localhost:8081

# Initial Administrator Provisioning (used if database has zero users)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password_2026!

# Backup Configuration
BACKUP_DIR=/var/backups/postgres
BACKUP_RETENTION_DAYS=14
# Optional: AES-256 backup encryption passphrase
BACKUP_ENCRYPTION_KEY=replace_with_backup_encryption_passphrase_if_enabled

# Migration Only: Source MongoDB URI (Not required at runtime)
MONGODB_URI=mongodb://127.0.0.1:27017/isuru_billing
